{
  "name": "tievora",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint",
    "dummy:run": "cross-env NEXT_PUBLIC_DUMMY_MODE=true next dev -p 3000 -H 0.0.0.0",
    "dummy:build": "cross-env NEXT_PUBLIC_DUMMY_MODE=true next build",
    "db:migrate": "node --loader ts-node/esm scripts/migrate.mjs 2>&1 || psql $DATABASE_URL -f db/schema.sql",
    "db:seed": "curl -X POST http://localhost:3000/api/seed",
    "db:seed:api": "curl -X POST http://localhost:3000/api/seed",
    "db:status": "curl http://localhost:3000/api/seed"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "framer-motion": "^11.3.24",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.462.0",
    "next": "14.2.13",
    "openai": "^7.4.0",
    "pg": "^8.23.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^4.1.3",
    "recharts": "^2.12.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.14.12",
    "@types/pg": "^8.21.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "cross-env": "^10.1.0"
  }
}